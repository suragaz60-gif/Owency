<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Roblox Send Simulation</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
        body { background-color: #121212; display: flex; justify-content: center; align-items: center; min-height: 100vh; color: #111; }
        
        /* Modal Container */
        .modal { width: 100%; max-width: 420px; height: 100vh; max-height: 750px; background: #ffffff; border-radius: 20px; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.5); position: relative; }
        
        /* Header */
        .header { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid #eaeaea; }
        .header-title { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 18px; }
        .balance-box { display: flex; align-items: center; gap: 6px; font-weight: 600; font-size: 16px; }
        .close-btn { background: none; border: none; font-size: 20px; cursor: pointer; color: #555; }

        /* Content Sections */
        .section { flex: 1; padding: 20px; display: none; flex-direction: column; overflow-y: auto; }
        .section.active { display: flex; }

        /* Search Screen */
        .search-bar { display: flex; align-items: center; background: #f0f0f0; border-radius: 12px; padding: 10px 14px; gap: 10px; margin-bottom: 20px; }
        .search-bar input { border: none; background: none; outline: none; width: 100%; font-size: 15px; }
        .friend-label { font-size: 14px; font-weight: 600; color: #666; margin-bottom: 12px; }
        .friend-item { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid #f7f7f7; cursor: pointer; }
        .avatar-circle { width: 44px; height: 44px; border-radius: 50%; background: #ddd; display: flex; align-items: center; justify-content: center; font-weight: bold; color: #555; overflow: hidden; }
        .avatar-circle img { width: 100%; height: 100%; object-fit: cover; }
        .friend-name { font-weight: 500; font-size: 15px; }

        /* Nominal Screen */
        .profile-preview { text-align: center; margin-bottom: 20px; }
        .profile-preview img { width: 70px; height: 70px; border-radius: 50%; margin-bottom: 8px; }
        .profile-preview .name { font-weight: 600; font-size: 16px; }
        .profile-preview .username { font-size: 13px; color: #777; }
        
        .amount-display { text-align: center; font-size: 36px; font-weight: 700; margin: 20px 0; display: flex; justify-content: center; align-items: center; gap: 8px; }
        
        .preset-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 20px; }
        .preset-btn { background: #f0f0f0; border: none; padding: 10px; border-radius: 8px; font-weight: 600; cursor: pointer; }
        .preset-btn:hover { background: #e0e0e0; }

        .action-btn { width: 100%; background: #007aff; color: white; border: none; padding: 14px; border-radius: 12px; font-weight: 600; font-size: 16px; cursor: pointer; margin-top: auto; }
        .action-btn:hover { background: #0062cc; }

        /* Keypad */
        .keypad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; background: #f7f7f7; padding: 12px; border-radius: 12px; margin-top: auto; }
        .key-btn { background: white; border: none; padding: 12px; font-size: 18px; font-weight: 600; border-radius: 8px; cursor: pointer; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }

        /* Success Screen */
        .success-content { text-align: center; justify-content: center; align-items: center; height: 100%; gap: 16px; }
        .success-icon { width: 64px; height: 64px; border-radius: 50%; border: 3px solid #333; display: flex; align-items: center; justify-content: center; font-size: 28px; font-weight: bold; }
    </style>
</head>
<body>

<div class="modal">
    <!-- Header Utama -->
    <div class="header">
        <div class="header-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            Send Robux
        </div>
        <div class="balance-box">
            <span>🪙</span>
            <span id="balanceDisplay">1,000,000</span>
        </div>
        <button class="close-btn" onclick="resetApp()">×</button>
    </div>

    <!-- TAHAP 1: Pilih / Cari Teman -->
    <div id="screen1" class="section active">
        <div class="search-bar">
            <span>🔍</span>
            <input type="text" id="searchInput" placeholder="Search username..." oninput="filterFriends(this.value)">
        </div>
        <div class="friend-label">My Friends (3)</div>
        <div id="friendList">
            <div class="friend-item" onclick="selectTarget('Nexvolt', 'https://tr.rbxcdn.com/30DAY-AvatarHeadshot-6B3C0F5E89745A170F2826F8017B4C83-Png/150/150/AvatarHeadshot/noFilter')">
                <div class="avatar-circle">N</div>
                <div class="friend-name">Nexvolt</div>
            </div>
            <div class="friend-item" onclick="selectTarget('Zyyforever', 'https://tr.rbxcdn.com/30DAY-AvatarHeadshot-D4830114F23D9E9E2A01234901C9A123-Png/150/150/AvatarHeadshot/noFilter')">
                <div class="avatar-circle">Z</div>
                <div class="friend-name">Zyyforever</div>
            </div>
            <div class="friend-item" onclick="selectTarget('Starfish', 'https://tr.rbxcdn.com/30DAY-AvatarHeadshot-123456789ABCDEF0123456789ABCDEF0-Png/150/150/AvatarHeadshot/noFilter')">
                <div class="avatar-circle">S</div>
                <div class="friend-name">Starfish</div>
            </div>
        </div>
    </div>

    <!-- TAHAP 2: Masukkan Nominal -->
    <div id="screen2" class="section">
        <div class="profile-preview">
            <img id="targetAvatar" src="" alt="Avatar">
            <div class="name" id="targetName">Nama</div>
            <div class="username" id="targetUsername">@username</div>
        </div>
        
        <div class="amount-display">
            <span>🪙</span> <span id="amountText">0</span>
        </div>

        <div class="preset-grid">
            <button class="preset-btn" onclick="setAmount(25)">25</button>
            <button class="preset-btn" onclick="setAmount(50)">50</button>
            <button class="preset-btn" onclick="setAmount(100)">100</button>
            <button class="preset-btn" onclick="setAmount(200)">200</button>
        </div>

        <button class="action-btn" onclick="goToConfirm()">Next</button>
    </div>

    <!-- TAHAP 3: Konfirmasi Kirim -->
    <div id="screen3" class="section" style="justify-content: center; text-align: center;">
        <div class="profile-preview">
            <img id="confirmAvatar" src="" alt="Avatar" style="width: 80px; height: 80px;">
            <div class="name" id="confirmName" style="font-size: 18px;">Nama</div>
            <div class="username" id="confirmUsername">@username</div>
        </div>

        <div style="font-size: 28px; font-weight: bold; margin: 20px 0;">
            🪙 <span id="confirmAmountText">0</span>
        </div>
        <p style="font-size: 13px; color: #666; margin-bottom: 30px;">The recipient will get the exact amount.</p>

        <button class="action-btn" onclick="executeSend()">Send</button>
    </div>

    <!-- TAHAP 4: Berhasil -->
    <div id="screen4" class="section">
        <div class="success-content">
            <div class="success-icon">✓</div>
            <div style="font-size: 18px; font-weight: 600;" id="successMsg">You sent 0 Robux</div>
            <button class="action-btn" onclick="resetApp()" style="margin-top: 20px;">OK</button>
        </div>
    </div>
</div>

<script>
    let currentBalance = 1000000;
    let selectedUser = { name: '', username: '', avatar: '' };
    let currentAmount = 0;

    function switchScreen(screenId) {
        document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
        document.getElementById(screenId).classList.add('active');
    }

    function selectTarget(name, avatar) {
        selectedUser = { name: name, username: '@' + name.toLowerCase(), avatar: avatar };
        
        document.getElementById('targetName').innerText = selectedUser.name;
        document.getElementById('targetUsername').innerText = selectedUser.username;
        document.getElementById('targetAvatar').src = selectedUser.avatar;
        
        currentAmount = 0;
        updateAmountDisplay();
        switchScreen('screen2');
    }

    function setAmount(val) {
        currentAmount = val;
        updateAmountDisplay();
    }

    function updateAmountDisplay() {
        document.getElementById('amountText').innerText = currentAmount;
    }

    function goToConfirm() {
        if (currentAmount <= 0) {
            alert('Pilih atau masukkan nominal terlebih dahulu!');
            return;
        }
        document.getElementById('confirmName').innerText = selectedUser.name;
        document.getElementById('confirmUsername').innerText = selectedUser.username;
        document.getElementById('confirmAvatar').src = selectedUser.avatar;
        document.getElementById('confirmAmountText').innerText = currentAmount;
        
        switchScreen('screen3');
    }

    function executeSend() {
        if (currentBalance < currentAmount) {
            alert('Saldo tidak cukup!');
            return;
        }
        currentBalance -= currentAmount;
        document.getElementById('balanceDisplay').innerText = currentBalance.toLocaleString();
        document.getElementById('successMsg').innerText = `You sent ${currentAmount} Robux`;
        
        switchScreen('screen4');
    }

    function resetApp() {
        currentAmount = 0;
        switchScreen('screen1');
    }

    function filterFriends(keyword) {
        // Simulasi filter pencarian teks sederhana
        const items = document.querySelectorAll('.friend-item');
        items.forEach(item => {
            const text = item.innerText.toLowerCase();
            if (text.includes(keyword.toLowerCase())) {
                item.style.display = 'flex';
            } else {
                item.style.display = 'none';
            }
        });
    }
</script>

</body>
</html>
